# No LLM key is required for the current RAG milestone.
# Future Content Agent provider examples:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Local Ollama settings used by the Performance and Intervention agents.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL_NAME=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
