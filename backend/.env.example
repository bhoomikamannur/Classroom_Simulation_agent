# Shared MongoDB Atlas database used by both local development and Render.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_DATABASE=classroom_simulation

# Uploaded original files are stored in the MongoDB GridFS bucket.
FILE_STORAGE_PROVIDER=gridfs

# Local frontend origin. On Render, set this to your Vercel deployment URL.
FRONTEND_ORIGINS=http://localhost:5173

# Authentication secrets: generate your own strong values; never commit real secrets.
JWT_SECRET_KEY=replace-with-a-long-random-secret
PROFESSOR_REGISTRATION_CODE=replace-with-your-registration-code

# Ollama must be running locally for local LLM-powered features.
# Render cannot access your local computer's 127.0.0.1 address.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL_NAME=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
